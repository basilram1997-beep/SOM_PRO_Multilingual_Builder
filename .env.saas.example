# SaaS mode: commercial desktop connects to central SOM PRO servers
# Replace the example URLs with your real HTTPS domain before building the installer.
SOM_RUNTIME_MODE=saas
VITE_API_URL=https://api.sompro.example
SOM_API_URL=https://api.sompro.example
SOM_LICENSE_SERVER_URL=https://license.sompro.example
SOM_PRO_LICENSE_SERVER_URL=https://license.sompro.example
SOM_PRO_REQUIRE_CENTRAL_LICENSE=true

SOM_AI_ENABLED=false
SOM_AI_NO_TRAINING=true
SOM_AI_CONTENT_FILTERS=true
SOM_AI_STORE_HISTORY=false
SOM_AI_HISTORY_ENCRYPTED=true
SOM_AI_OUTPUT_MONITORING=true
SOM_AI_ALLOW_EXTERNAL_PROCESSING=false
SOM_AI_RESTRICT_EXTERNAL_STORAGE_TO_ISRAEL=true
SOM_AI_DATA_RESIDENCY=IL
SOM_AI_PROMPT_MAX_CHARS=4000
SOM_AI_OUTPUT_MAX_CHARS=2000
SOM_AI_HISTORY_MAX_CHARS=25000
