# SOM PRO staging environment example
# Copy to .env.staging on the staging machine and replace CHANGE_ME values.
# Do not commit real secrets.

NODE_ENV=production
APP_ENV=staging
SOM_RUNTIME_MODE=saas
SOM_RELEASE_CHANNEL=release-candidate
SOM_VERSION=0.9.0-rc.1
SOM_API_ENV=staging

APP_URL=https://sompro.duckdns.org
PUBLIC_APP_URL=https://sompro.duckdns.org
VITE_API_URL=/api
SOM_API_URL=https://sompro.duckdns.org/api
SOM_LICENSE_SERVER_URL=https://sompro.duckdns.org/license
SOM_PRO_LICENSE_SERVER_URL=https://sompro.duckdns.org/license
CORS_ORIGIN=https://sompro.duckdns.org
VITE_SOM_SHOW_OPERATOR_HEALTH=true
SOM_ENABLE_OPERATOR_HEALTH=true
SOM_NOTIFICATION_WEBHOOK_URL=https://alerts.sompro.duckdns.org/webhook
SOM_SMS_WEBHOOK_URL=https://sms.sompro.duckdns.org/webhook
SOM_AUTO_BACKUP_INTERVAL_HOURS=24
SOM_AUTO_BACKUP_RUN_ON_START=true
SOM_BACKUP_PASSPHRASE_FILE=/run/secrets/som_backup_passphrase
SOM_BACKUP_RPO_MINUTES=1440
SOM_BACKUP_RTO_MINUTES=240
SOM_REDUNDANCY_MODE=single-region
SOM_REPLICA_DATABASE_URL=postgresql://replica_user:replica_password@staging-db-replica.sompro.internal:5432/som?schema=public
SOM_REPLICA_API_URL=https://sompro-replica.duckdns.org/api
SOM_REPLICA_LICENSE_SERVER_URL=https://sompro-replica.duckdns.org/license

DATABASE_URL=postgresql://CHANGE_ME
REDIS_URL=redis://redis:6379
JWT_SECRET=CHANGE_ME
SOM_PRO_LICENSE_SECRET=CHANGE_ME
LICENSE_ADMIN_TOKEN=CHANGE_ME

SOM_AI_ENABLED=false
SOM_AI_NO_TRAINING=true
SOM_AI_CONTENT_FILTERS=true
SOM_AI_STORE_HISTORY=false
SOM_AI_HISTORY_ENCRYPTED=true
SOM_AI_OUTPUT_MONITORING=true
SOM_AI_ALLOW_EXTERNAL_PROCESSING=false
SOM_AI_RESTRICT_EXTERNAL_STORAGE_TO_ISRAEL=true
SOM_AI_DATA_RESIDENCY=IL
SOM_AI_PROMPT_MAX_CHARS=4000
SOM_AI_OUTPUT_MAX_CHARS=2000
SOM_AI_HISTORY_MAX_CHARS=25000
