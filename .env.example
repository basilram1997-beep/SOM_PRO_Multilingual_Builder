# SOM PRO environment example
# Runtime modes: development, local-trial, saas

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:5173

SOM_RUNTIME_MODE=development
PORT=4000
DATABASE_URL="postgresql://som_user:som_password@localhost:5432/som?schema=public"
REDIS_URL="redis://localhost:6379"
CORS_ORIGIN="http://localhost:5173"

# Frontend/Desktop API target
VITE_API_URL=http://localhost:4000
SOM_API_URL=http://localhost:4000
SOM_PRO_APP_URL=http://localhost:5173

# License server
SOM_LICENSE_SERVER_URL=http://localhost:4100
SOM_PRO_LICENSE_SERVER_URL=http://localhost:4100
SOM_PRO_REQUIRE_CENTRAL_LICENSE=false

# Secrets: replace before any real deployment
SOM_PRO_LICENSE_SECRET=change-this-secret-before-selling
SOM_PRO_AUTH_SECRET=change-this-auth-secret-before-selling
SOM_PRO_AUTH_INACTIVITY_TIMEOUT_SECONDS=1800
SOM_PRO_ADMIN_EMAIL=admin@sompro.local
SOM_PRO_ADMIN_PASSWORD=change-this-admin-password

# AI policy defaults: keep disabled until a future approved module exists
SOM_AI_ENABLED=false
SOM_AI_NO_TRAINING=true
SOM_AI_CONTENT_FILTERS=true
SOM_AI_STORE_HISTORY=false
SOM_AI_HISTORY_ENCRYPTED=true
SOM_AI_OUTPUT_MONITORING=true
SOM_AI_ALLOW_EXTERNAL_PROCESSING=false
SOM_AI_RESTRICT_EXTERNAL_STORAGE_TO_ISRAEL=true
SOM_AI_DATA_RESIDENCY=IL
SOM_AI_PROMPT_MAX_CHARS=4000
SOM_AI_OUTPUT_MAX_CHARS=2000
SOM_AI_HISTORY_MAX_CHARS=25000
