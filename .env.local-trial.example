# Local Trial mode: one-machine demo/testing flow
# This mode may still need Node.js, Docker Desktop, PostgreSQL/Redis containers.
SOM_RUNTIME_MODE=local-trial
VITE_API_URL=http://localhost:4000
SOM_API_URL=http://localhost:4000
SOM_PRO_APP_URL=http://localhost:5173
SOM_LICENSE_SERVER_URL=http://localhost:4100
SOM_PRO_LICENSE_SERVER_URL=http://localhost:4100
SOM_PRO_REQUIRE_CENTRAL_LICENSE=false

SOM_AI_ENABLED=false
SOM_AI_NO_TRAINING=true
SOM_AI_CONTENT_FILTERS=true
SOM_AI_STORE_HISTORY=false
SOM_AI_HISTORY_ENCRYPTED=true
SOM_AI_OUTPUT_MONITORING=true
SOM_AI_ALLOW_EXTERNAL_PROCESSING=false
SOM_AI_RESTRICT_EXTERNAL_STORAGE_TO_ISRAEL=true
SOM_AI_DATA_RESIDENCY=IL
SOM_AI_PROMPT_MAX_CHARS=4000
SOM_AI_OUTPUT_MAX_CHARS=2000
SOM_AI_HISTORY_MAX_CHARS=25000
