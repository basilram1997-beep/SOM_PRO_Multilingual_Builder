# Backend staging env example. Do not put real secrets in Git.
NODE_ENV=production
SOM_RUNTIME_MODE=saas
SOM_RELEASE_CHANNEL=release-candidate
SOM_VERSION=0.9.0-rc.1
SOM_API_ENV=staging
PORT=4000
DATABASE_URL=postgresql://CHANGE_ME
REDIS_URL=redis://redis:6379
JWT_SECRET=CHANGE_ME
SOM_TRUST_PROXY=1
CORS_ORIGIN=https://staging-app.example.invalid
SOM_LICENSE_SERVER_URL=https://staging-license.example.invalid
SOM_ENABLE_OPERATOR_HEALTH=true
SOM_NOTIFICATION_WEBHOOK_URL=https://alerts.example.invalid/webhook
SOM_SMS_WEBHOOK_URL=https://sms.example.invalid/webhook
SOM_AUTO_BACKUP_INTERVAL_HOURS=24
SOM_AUTO_BACKUP_RUN_ON_START=true
SOM_REDUNDANCY_MODE=single-region
SOM_REPLICA_DATABASE_URL=postgresql://replica_user:replica_password@staging-db-replica.example.invalid:5432/som?schema=public
SOM_REPLICA_API_URL=https://staging-api-replica.example.invalid
SOM_REPLICA_LICENSE_SERVER_URL=https://staging-license-replica.example.invalid
