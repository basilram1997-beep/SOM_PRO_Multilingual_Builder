# Backend staging env example. Do not put real secrets in Git.
NODE_ENV=production
SOM_RUNTIME_MODE=saas
SOM_RELEASE_CHANNEL=release-candidate
SOM_VERSION=0.9.0-rc.1
SOM_API_ENV=staging
PORT=4000
DATABASE_URL=postgresql://CHANGE_ME
REDIS_URL=redis://redis:6379
JWT_SECRET=CHANGE_ME
SOM_TRUST_PROXY=1
CORS_ORIGIN=https://staging-app.your-domain.com
SOM_LICENSE_SERVER_URL=https://staging-license.your-domain.com
