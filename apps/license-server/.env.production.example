NODE_ENV=production
APP_ENV=production
APP_DEBUG=false
LICENSE_PORT=4100
SOM_PRO_LICENSE_SECRET=change-me-long-random-license-secret
LICENSE_ADMIN_TOKEN=change-me-long-random-owner-token
PUBLIC_BASE_URL=https://app.example.com/license
CORS_ORIGIN=https://app.example.com
# Use Redis for shared rate limiting and nonce replay protection across instances.
LICENSE_REQUEST_BACKING=redis
LICENSE_REDIS_URL=redis://:change-me-strong-redis-password@redis:6379
# Real production values must come from a deployment secret store or KMS-backed injection.
