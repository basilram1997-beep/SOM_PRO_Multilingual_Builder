FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY apps/license-server/package.json apps/license-server/package.json
COPY apps/license-server/src apps/license-server/src
COPY apps/license-server/public apps/license-server/public
RUN mkdir -p apps/license-server/data
WORKDIR /app/apps/license-server
EXPOSE 4100
CMD ["node", "src/server.js"]
