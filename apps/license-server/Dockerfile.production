FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache openssl
COPY package*.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/license-server/package.json apps/license-server/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --omit=dev -w apps/license-server -w apps/backend -w packages/shared
COPY scripts scripts
COPY apps/backend/prisma apps/backend/prisma
COPY apps/license-server/src apps/license-server/src
COPY apps/license-server/public apps/license-server/public
RUN npm run prisma:generate -w apps/backend
WORKDIR /app/apps/license-server
EXPOSE 4100
CMD ["node", "src/server.js"]
