{
  "name": "@som/desktop",
  "version": "0.9.0-rc.1",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build:win": "npx electron-builder --config electron-builder.config.cjs --win nsis",
    "build:win:signed": "set SOM_ENABLE_CODESIGN=true&& npx electron-builder --config electron-builder.config.cjs --win nsis",
    "build:dir": "npx electron-builder --config electron-builder.config.cjs --dir",
    "build:dir:signed": "set SOM_ENABLE_CODESIGN=true&& npx electron-builder --config electron-builder.config.cjs --dir",
    "check": "node src/desktopCheck.js"
  },
  "devDependencies": {
    "electron": "^42.8.1",
    "electron-builder": "26.15.3"
  },
  "description": "SOM PRO desktop application",
  "author": "SOM PRO",
  "packageManager": "npm@11.16.0"
}
