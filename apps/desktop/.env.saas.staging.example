# Desktop SaaS staging env example.
# Copy values into the build environment before running npm run release:build:saas.
SOM_RUNTIME_MODE=saas
SOM_API_ENV=staging
SOM_API_URL=https://staging-api.your-domain.com
VITE_API_URL=https://staging-api.your-domain.com
SOM_LICENSE_SERVER_URL=https://staging-license.your-domain.com
SOM_PRO_LICENSE_SERVER_URL=https://staging-license.your-domain.com