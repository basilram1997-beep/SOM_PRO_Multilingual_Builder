# SOM PRO production root environment example
# Copy to .env.production on the server and replace every placeholder.
# Do not commit real production secrets.

NODE_ENV=production
APP_ENV=production
APP_DEBUG=false
APP_URL=https://som-pro.pages.dev
PUBLIC_APP_URL=https://som-pro.pages.dev
SOM_RUNTIME_MODE=saas

POSTGRES_DB=som
POSTGRES_USER=som_user
POSTGRES_PASSWORD=change-me-strong-postgres-password
DATABASE_URL=postgresql://som_user:change-me-strong-postgres-password@postgres:5432/som?schema=public
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis:6379
SOM_PRO_RATE_LIMIT_BACKING=redis

APP_DOMAIN=som-pro.pages.dev

CORS_ORIGIN=https://som-pro.pages.dev
VITE_API_URL=/api
SOM_API_URL=https://som-pro.pages.dev/api
SOM_LICENSE_SERVER_URL=https://som-pro.pages.dev/license
SOM_PRO_LICENSE_SERVER_URL=https://som-pro.pages.dev/license

SOM_PRO_REQUIRE_CENTRAL_LICENSE=true
SOM_PRO_LICENSE_GRACE_DAYS=3
SOM_PRO_LICENSE_TIMEOUT_MS=5000

SOM_PRO_LICENSE_SECRET=change-me-long-random-license-secret
SOM_PRO_AUTH_SECRET=change-me-long-random-auth-secret
SOM_PRO_AUTH_INACTIVITY_TIMEOUT_SECONDS=1800
SOM_PRO_ADMIN_EMAIL=owner-admin@example.com
SOM_PRO_ADMIN_PASSWORD=change-me-first-admin-password
LICENSE_ADMIN_TOKEN=change-me-long-random-owner-token

# Prefer a deployment secret store, Docker secrets, or KMS-backed injection for real values.
# Backup scripts support SOM_BACKUP_PASSPHRASE_FILE so the passphrase is not stored in this file.
SOM_BACKUP_PASSPHRASE_FILE=/run/secrets/som_backup_passphrase
SOM_BACKUP_RPO_MINUTES=1440
SOM_BACKUP_RTO_MINUTES=240
SOM_STORAGE_PATH=/var/lib/sompro/uploads
SOM_FILE_UPLOAD_SCANNING_ENABLED=true
SOM_FILE_UPLOAD_SCANNER_URL=tcp://scanner.internal:3310
SOM_FILE_UPLOAD_SCANNER_TIMEOUT_MS=5000

SOM_AI_ENABLED=false
SOM_AI_NO_TRAINING=true
SOM_AI_CONTENT_FILTERS=true
SOM_AI_STORE_HISTORY=false
SOM_AI_HISTORY_ENCRYPTED=true
SOM_AI_OUTPUT_MONITORING=true
SOM_AI_ALLOW_EXTERNAL_PROCESSING=false
SOM_AI_RESTRICT_EXTERNAL_STORAGE_TO_ISRAEL=true
SOM_AI_DATA_RESIDENCY=IL
SOM_AI_PROMPT_MAX_CHARS=4000
SOM_AI_OUTPUT_MAX_CHARS=2000
SOM_AI_HISTORY_MAX_CHARS=25000
