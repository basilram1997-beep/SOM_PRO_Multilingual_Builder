{
  "name": "som-pro-hybrid-perfect-builder",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/desktop",
    "packages/shared",
    "apps/license-server"
  ],
  "scripts": {
    "install:all": "npm install",
    "build:shared": "npm run build -w packages/shared",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev:desktop": "npm run dev -w apps/desktop",
    "build:backend": "npm run build -w apps/backend",
    "build:frontend": "npm run build -w apps/frontend",
    "typecheck:shared": "npm run typecheck -w packages/shared",
    "typecheck:backend": "npm run typecheck -w apps/backend",
    "typecheck:frontend": "npm run typecheck -w apps/frontend",
    "typecheck": "npm run typecheck:shared && npm run typecheck:backend && npm run typecheck:frontend",
    "build:desktop:win": "npm run build:win -w apps/desktop",
    "build": "npm run build:shared \u0026\u0026 npm run build:backend \u0026\u0026 npm run build:frontend",
    "setup:db": "npm run setup:env \u0026\u0026 node scripts/ensure-prisma-baseline.js \u0026\u0026 npm run prisma:migrate:deploy -w apps/backend \u0026\u0026 npm run prisma:seed -w apps/backend",
    "setup:env": "node scripts/ensure-env.js",
    "build:web": "npm run build:frontend",
    "build:hybrid": "npm run build:shared \u0026\u0026 npm run build:backend \u0026\u0026 npm run build:frontend \u0026\u0026 npm run build:desktop:win",
    "preview:web": "npm run preview -w apps/frontend",
    "license:generate": "node scripts/generate-license.js",
    "check": "npm run lint \u0026\u0026 npm run build \u0026\u0026 npm run test",
    "dev:license-server": "npm run dev -w apps/license-server",
    "start:license-server": "npm run start -w apps/license-server",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "lint": "eslint .",
    "security:audit": "npm audit --omit=dev",
    "security:outdated": "npm outdated",
    "security:deps": "npm audit --omit=dev",
    "security:sast": "eslint .",
    "security:dast": "npm run staging:smoke",
    "security:review": "npm run security:deps && npm run security:sast && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test -w apps/backend && npm test -w apps/frontend",
    "desktop:dev": "npm run dev:desktop",
    "desktop:build:win": "npm run build:desktop:win",
    "desktop:build:win:signed": "npm run build:win:signed -w apps/desktop",
    "desktop:build:dir:signed": "npm run build:dir:signed -w apps/desktop",
    "desktop:check": "npm run check -w apps/desktop",
    "desktop:build:trial": "node scripts/build-desktop-trial.js",
    "desktop:build:saas": "node scripts/build-desktop-saas.js",
    "desktop:check:saas": "node scripts/desktop-check-saas.js",
    "e2e:bootstrap": "node scripts/e2e-bootstrap.js",
    "dev:frontend:e2e": "npm run dev:e2e -w apps/frontend",
    "dev:e2e": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend:e2e\"",
    "e2e:serve": "node scripts/e2e-server.js",
    "test:e2e:browser": "node scripts/run-e2e-browser.js",
    "test:e2e:browser:headed": "node scripts/run-e2e-browser.js --headed",
    "test:e2e:browser:smoke:core": "node scripts/run-e2e-browser.js tests/e2e/playwright/login-and-navigation.spec.js tests/e2e/playwright/navigation-and-account.spec.js",
    "test:e2e:browser:smoke:students": "node scripts/run-e2e-browser.js tests/e2e/playwright/attendance-flow.spec.js tests/e2e/playwright/grade-entry-flow.spec.js tests/e2e/playwright/certificate-flow.spec.js",
    "test:e2e:browser:smoke:daily": "node scripts/run-e2e-browser.js tests/e2e/playwright/daily-substitutions-flow.spec.js tests/e2e/playwright/reports-and-archive-flow.spec.js",
    "test:e2e:browser:smoke": "npm run test:e2e:browser:smoke:core && npm run test:e2e:browser:smoke:students && npm run test:e2e:browser:smoke:daily",
    "test:e2e:browser:certificate-visual": "node scripts/run-e2e-browser.js tests/e2e/playwright/certificate-preview-visual.spec.js",
    "test:e2e:browser:permissions": "node scripts/run-e2e-browser.js tests/e2e/playwright/permissions-access.spec.js",
    "test:e2e:browser:install": "playwright install chromium",
    "stress:run": "node scripts/stress-run.js",
    "stress:login": "node scripts/stress-run.js --scenario=login",
    "stress:grades": "node scripts/stress-run.js --scenario=grades",
    "stress:attendance": "node scripts/stress-run.js --scenario=attendance",
    "stress:reports": "node scripts/stress-run.js --scenario=reports",
    "stress:outage": "node scripts/stress-run.js --scenario=outage",
    "capture:certificate-preview": "node scripts/capture-certificate-preview.js",
    "perf:seed": "node scripts/perf-seed.js",
    "perf:cleanup": "node scripts/perf-seed.js --cleanup",
    "perf:verify": "node scripts/perf-verify.js",
    "perf:measure": "node scripts/perf-measure.js",
    "perf:analyze": "node scripts/perf-analyze.js",
    "perf:run": "node scripts/perf-run.js",
    "perf:baseline": "node scripts/perf-run.js --mode=baseline",
    "perf:normal": "node scripts/perf-run.js --mode=normal",
    "perf:peak": "node scripts/perf-run.js --mode=peak",
    "perf:spike": "node scripts/perf-run.js --mode=spike",
    "perf:soak": "node scripts/perf-run.js --mode=soak",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w apps/backend",
    "production:check": "node scripts/production-check.js",
    "test:contracts": "npm run test:contracts -w apps/backend",
    "test:e2e": "npm run test:e2e -w apps/backend",
    "test:all": "npm run test \u0026\u0026 npm run test:contracts \u0026\u0026 npm run test:e2e",
    "release:check": "npm run build \u0026\u0026 npm run lint \u0026\u0026 npm run test \u0026\u0026 npm run test:all \u0026\u0026 npm run check \u0026\u0026 npm run desktop:check \u0026\u0026 npm run desktop:check:saas \u0026\u0026 npm run production:check",
    "release:build:saas": "npm run desktop:build:saas",
    "release:build:trial": "node scripts/build-desktop-trial.js",
    "release:notes": "node scripts/release-notes.js",
    "staging:check": "node scripts/staging-check.js",
    "staging:smoke": "node scripts/staging-smoke.js"
  },
  "version": "0.9.0-rc.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "concurrently": "^10.0.3",
    "cypress": "^15.18.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.3",
    "typescript-eslint": "^8.62.0"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "app-builder-bin": "^4.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "cypress@15.18.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true
  },
  "packageManager": "npm@11.16.0"
}
